#!/bin/sh /etc/rc.common
# pcat2d - Photonicat2 display and device-control daemon
# procd-managed service.

USE_PROCD=1
START=90
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/pcat2d -socket /var/run/pcat2d.sock
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
