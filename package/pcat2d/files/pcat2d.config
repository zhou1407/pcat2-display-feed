config pcat2d 'global'
	option fan_mode 'smart_cool'
	option fan_level '4'
	option charge_limit '100'
	option led_mode 'on'
	option led_start '08:00'
	option led_end '22:00'
	option beeper_mode 'on'
	option beeper_start '08:00'
	option beeper_end '22:00'
	option brightness '50'
	option dim_battery_sec '60'
	option dim_charger_sec '300'
	option movement '1'
	option monthly_limit_gb '9999'
